; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   key=value
;   ...

[application]

config/name="诡则像素：泰安医院"
config/description="A pixel horror game with evolving rules"
config/version="1.0"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.png"

[display]

window/size/width=640
window/size/height=360
window/resizeable=false
window/fullscreen=false
window/title="诡则像素：泰安医院"

[rendering]

quality/driver/driver_name="GLES3"
display/window/stretch/mode="2d"
display/window/stretch/aspect="keep"
display/window/stretch/shrink=2

[input]

left={"deadzone": 0.5, "events": [{"type": "keyboard", "scancode": 65}]}
right={"deadzone": 0.5, "events": [{"type": "keyboard", "scancode": 68}]}
jump={"deadzone": 0.5, "events": [{"type": "keyboard", "scancode": 32}]}
interact={"deadzone": 0.5, "events": [{"type": "keyboard", "scancode": 69}]}
notebook={"deadzone": 0.5, "events": [{"type": "keyboard", "scancode": 84}, {"type": "keyboard", "scancode": 73}]}

[physics]

common/enable_pause_aware_picking=true

[physics/2d]

default_gravity=1000.0